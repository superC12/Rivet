router:
  strategy: auto
  engine: builtin
  prefer_local: true
  fallback: openrouter-main
  privacy_mode: standard
  session_affinity: true
  # Models excluded during onboarding or later in Settings → Routing.
  # Use provider:model so identical tags on different servers remain distinct.
  disabled_models: []
  # Highest priority first. Models missing from this list follow in their
  # provider-defined order.
  model_priority: []

  # Optional model-assisted selection. Leave disabled to use Rivet's normal
  # router with no extra inference call. `model` uses provider:model identity.
  routing_model:
    enabled: false
    model: ""
    # auto lets the routing model decide per request; never and always are
    # explicit overrides. Unsupported targets safely run without thinking.
    thinking_policy: auto

  classifier:
    # heuristic - deterministic patterns, needs nothing installed.
    # dispatch  - asks a model you select and configure yourself. Rivet
    #             ships no model or recipe. Score your choice with
    #             `python eval/run_eval.py --mode dispatch --model <name>`.
    #
    # Every value below can be overridden by the environment, so the
    # dispatcher can be pointed at the always-on server without editing
    # this file: RIVET_CLASSIFIER_MODE, RIVET_DISPATCH_ENDPOINT,
    # RIVET_DISPATCH_MODEL, RIVET_DISPATCH_TIMEOUT_S, RIVET_FALLBACK_LANE.
    mode: heuristic
    endpoint: http://127.0.0.1:11434
    model: ""
    timeout_s: 5.0
    # Where an unreadable classification lands. ESCALATE fails upward:
    # a slightly larger bill beats a confidently wrong answer. Set LOCAL
    # to invert that trade.
    fallback_lane: ESCALATE

providers:
  local-ollama:
    type: ollama
    node: homelab
    endpoint: http://127.0.0.1:11434
    # Bounded server-side discovery: no LAN scan. Rivet tries the explicit
    # endpoint first, followed by these common Docker locations. Add more
    # through RIVET_OLLAMA_ENDPOINTS as a comma-separated environment value.
    auto_detect: true
    discovery_endpoints:
      - http://host.docker.internal:11434
      - http://ollama:11434

  openrouter-main:
    type: openrouter

nodes:
  homelab:
    type: local
    display_name: Homelab
    always_on: true

actions:
  # Rivet reports an action as done only when the gateway confirms it.
  # The webhook URL carries its own authorisation, so it is treated as a
  # credential and is never returned through the API.
  n8n:
    enabled: false
    endpoint: ""
    timeout_s: 30.0

onboarding:
  complete: false

logging:
  verbose: false
